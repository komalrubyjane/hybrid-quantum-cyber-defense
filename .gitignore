# --- Data: never commit datasets (only README + manifest are tracked) ---
data/*
!data/README.md
!data/MANIFEST.yaml

# --- Models: generated checkpoints are local artifacts ---
models/generated/
models/**/*.pt
models/**/*.pkl
models/**/*.joblib
models/**/*.npz

# --- Experiment outputs / local storage ---
reports/runs/
*.sqlite
*.sqlite3
*.db

# --- Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/

# --- Large dataset archives that could land anywhere ---
*.zip
*.tar.gz
*.parquet
*.pcap
*.pcapng
*.csv
!tests/fixtures/**/*.csv
# Final result tables (small, generated by evaluation/build_final_report.py) are part of the record.
!artifacts/final/tables/*.csv

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/coverage/

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/
