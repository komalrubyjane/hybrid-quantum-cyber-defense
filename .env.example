# Copy to .env and adjust. Never commit .env.
# All variables are optional; defaults come from configs/default.yaml.

# Deployment profile label (informational): development | test | research
HQC_ENVIRONMENT=development

# Global random seed used by every run unless overridden
HQC_SEED=42

# MITRE ATT&CK Enterprise version. PLANNED target is 19.2; it must be verified
# against the official release before the knowledge base is built (Milestone 2).
ATTACK_VERSION=19.2

# Local paths (relative paths resolve against the project root)
HQC_DATA_DIR=data
HQC_MODELS_DIR=models
HQC_REPORTS_DIR=reports
HQC_DB_PATH=data/hqc.sqlite3

# Logging: DEBUG | INFO | WARNING | ERROR ; HQC_LOG_JSON=true emits JSON lines
HQC_LOG_LEVEL=INFO
HQC_LOG_JSON=true

# API
HQC_API_HOST=127.0.0.1
HQC_API_PORT=8000
HQC_CORS_ORIGINS=["http://localhost:5173"]
